.git
.git/
.superpowers
.superpowers/
.worktrees
.worktrees/

# Keep only the checked-in example; runtime credentials must stay outside the
# build context and are persisted in the mounted data volume instead.
.env*
!.env.example
config.ini
**/config.ini
web_config.json
**/web_config.json
secret.key
**/secret.key
*.key
**/*.key
*.pem
**/*.pem
cookies.txt
.cookies.txt
**/cookies.txt
**/.cookies.txt

# Runtime data and generated frontend dependencies/artifacts.
data
data/
**/data
web/dist
web/dist/
web/node_modules
web/node_modules/
tests
tests/
**/tests

# Python, test, editor, and build caches.
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
**/.pytest_cache
.mypy_cache
**/.mypy_cache
.ruff_cache
**/.ruff_cache
.cache
**/.cache
.npm
**/.npm
.venv
**/.venv
venv
**/venv
*.log
logs
**/logs
coverage.xml
.coverage
htmlcov
build
build/
dist
dist/
cache.json
**/cache.json
*.db
**/*.db
*.sqlite
**/*.sqlite
*.sqlite3
**/*.sqlite3
saves
**/saves

# Volume backups must never be sent in the build context.  The exact default
# filename is covered alongside the general archive patterns for renamed or
# nested copies.
chaoxing-data-backup.tgz
*.tgz
**/*.tgz
*.tar.gz
**/*.tar.gz
*.tar
**/*.tar

# Archives and portable build output are distribution artifacts, not image
# inputs.  Exclude them at every nesting level to keep Docker context small.
*.zip
**/*.zip
portable/
**/portable/
chaoxing_portable/
**/chaoxing_portable/
portable_build/
**/portable_build/
build_portable/
**/build_portable/
